# Kopieer dit bestand naar .env en vul je eigen waarden in
# cp .env.example .env

# OpenAI API key (verplicht)
OPENAI_API_KEY=sk-proj-jouw-key-hier

# Database pad (optioneel — standaard: data/powned.db)
DATABASE_URL=sqlite:///data/powned.db

# Server poort (optioneel — standaard: 5001)
# PORT=5001

# Any long random string, used to hash dashboard passwords (keep it secret)
POWNED_SALT=change-me-to-a-long-random-string
